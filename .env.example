# ──────────────────────────────────────────────────────────────────
# Environment variables for the Zero-Trust Policy Audit Engine.
# Copy this file to .env and fill in real values before running.
#
#   cp .env.example .env
#
# NEVER commit your .env file — it may contain real credentials.
# ──────────────────────────────────────────────────────────────────

# PostgreSQL Configuration
POSTGRES_USER=audituser
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=auditdb

# Audit Service
DATABASE_URL=postgresql://audituser:changeme_use_a_strong_password@db:5432/auditdb?sslmode=disable
AUDIT_SERVICE_PORT=8080

# Kubernetes — path inside the container (mapped via docker-compose volume)
KUBECONFIG=/home/appuser/.kube/config
